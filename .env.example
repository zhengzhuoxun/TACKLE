# =============================================================================
# TableQA — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control (it's already in .gitignore if you
# have one).

# ---- LLM Provider ----
TABLEQA_LLM_PROVIDER=deepseek
TABLEQA_LLM_MODEL=deepseek-flash
TABLEQA_LLM_API_KEY=<deepseek key>
TABLEQA_LLM_TEMPERATURE=0
TABLEQA_LLM_MAX_TOKENS=4096

# TABLEQA_OPENAI_API_KEY=<a real OpenAI key>
# For Aqueduct, use your instance base URL with /v1 appended, for example:
# TABLEQA_LLM_PROVIDER=aqueduct
# TABLEQA_LLM_API_BASE=https://your-aqueduct-instance.example.com/v1

